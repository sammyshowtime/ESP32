// Copy this file to include/secrets.h and fill in your own values.
// include/secrets.h is gitignored so your credentials stay out of the repo.
#pragma once

#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Optional. When non-empty, every /api/* request must carry this token,
// either as an X-Auth-Token header or a ?token= query parameter.
// Leave it as "" to run the remote without authentication.
#define API_TOKEN ""
